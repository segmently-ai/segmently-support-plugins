          "kind": "static",
          "appearance": {
            "align": "start",
            "fontSize": 17,
            "fontWeight": 650,
            "lineHeight": 24,
            "color": "#172033"
          }
        },
        "subtitle": {
          "translations": {
            "en": "Decides whether your custom HTML runs in a protected sandbox (On, the default) or directly in the page (Off). Leave it On — the sandbox stops your CSS and JavaScript from leaking out and breaking the rest of the screen. Only switch it Off if your code truly needs to reach the surrounding page, and expect to debug styling clashes if you do."
          },
          "kind": "static",
          "appearance": {
            "align": "start",
            "fontSize": 15,
