{
  "schemaVersion": 1,
  "purpose": "Naive customer-surface eval corpus for the Segmently launch guide. Three independent personas ask imprecise, beginner questions across the main paid web funnel flow. Every question must be answerable from shipped text guidance plus screenshot-backed guide evidence, and DO requests must map to a CLI/E2E/handoff contract when possible.",
  "policy": {
    "personaCount": 3,
    "minimumQuestionsPerPersona": 10,
    "minimumGuidance": "text-plus-screenshot-evidence",
    "articleHtmlRequired": false,
    "articleLinkPreferred": true,
    "doWhenPossible": true
  },
